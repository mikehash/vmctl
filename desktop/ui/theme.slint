    out property <string> layers: "M12 2 L2 7 L12 12 L22 7 Z M2 17 L12 22 L22 17 M2 12 L12 17 L22 12";
    out property <string> network: "M10 2 H14 A1 1 0 0 1 15 3 V7 A1 1 0 0 1 14 8 H10 A1 1 0 0 1 9 7 V3 A1 1 0 0 1 10 2 Z M3 16 H7 A1 1 0 0 1 8 17 V21 A1 1 0 0 1 7 22 H3 A1 1 0 0 1 2 21 V17 A1 1 0 0 1 3 16 Z M17 16 H21 A1 1 0 0 1 22 17 V21 A1 1 0 0 1 21 22 H17 A1 1 0 0 1 16 21 V17 A1 1 0 0 1 17 16 Z M5 16 V13 H19 V16 M12 8 V13";
    out property <string> activity: "M22 12 L18 12 L15 21 L9 3 L6 12 L2 12";
    out property <string> x: "M6 6 L18 18 M18 6 L6 18";
