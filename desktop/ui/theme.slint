    out property <string> check: "M20 6 L9 17 L4 12";
    out property <string> shield: "M12 2 L20 6 V12 C20 17 16.5 20.5 12 22 C7.5 20.5 4 17 4 12 V6 Z";
    out property <string> trash: "M3 6 L21 6 M19 6 L18 20 H6 L5 6 M10 11 V17 M14 11 V17 M9 6 V4 H15 V6";
    out property <string> rollback: "M9 14 L4 9 L9 4 M4 9 H14.5 A5.5 5.5 0 0 1 14.5 20 H11";
    out property <string> alert: "M10.3 3.9 L1.8 18 A2 2 0 0 0 3.5 21 H20.5 A2 2 0 0 0 22.2 18 L13.7 3.9 A2 2 0 0 0 10.3 3.9 Z M12 9 L12 13 M12 17 L12.01 17";
    out property <string> disc: "M21 12 A9 9 0 1 1 3 12 A9 9 0 1 1 21 12 Z M14 12 A2 2 0 1 1 10 12 A2 2 0 1 1 14 12 Z";
    out property <string> disk: "M12 2 C17 2 21 3.3 21 5 V19 C21 20.7 17 22 12 22 C7 22 3 20.7 3 19 V5 C3 3.3 7 2 12 2 Z M3 5 C3 6.7 7 8 12 8 C17 8 21 6.7 21 5 M3 12 C3 13.7 7 15 12 15 C17 15 21 13.7 21 12";
}

export component Icon inherits Path {
    in property <string> name;
    in property <color> color: C.text;
    in property <length> size: 16px;
    in property <float> weight: 2;
    property <bool> solid: name == "play" || name == "stop" || name == "pause";
    width: size;
    height: size;
    viewbox-width: 24;
    viewbox-height: 24;
    commands: name == "play" ? Icons.play : name == "stop" ? Icons.stop : name == "restart" ? Icons.restart
        : name == "pause" ? Icons.pause : name == "term" ? Icons.term : name == "camera" ? Icons.camera
        : name == "copy" ? Icons.copy : name == "power" ? Icons.power : name == "plus" ? Icons.plus
        : name == "search" ? Icons.search : name == "spark" ? Icons.spark : name == "server" ? Icons.server
        : name == "layers" ? Icons.layers : name == "network" ? Icons.network : name == "activity" ? Icons.activity
        : name == "x" ? Icons.x : name == "send" ? Icons.send : name == "check" ? Icons.check
        : name == "shield" ? Icons.shield : name == "trash" ? Icons.trash : name == "rollback" ? Icons.rollback
        : name == "alert" ? Icons.alert : name == "disc" ? Icons.disc : name == "disk" ? Icons.disk : "";
    fill: solid ? color : transparent;
    stroke: solid ? transparent : color;
    stroke-width: (weight * size / 24);
    stroke-line-cap: round;
}
