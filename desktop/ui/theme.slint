// Mission Control design tokens — 1:1 with the prototype.
// crimson = action, ember = focus/assistant; state colours never reuse crimson.

import "fonts/Rajdhani-Medium.ttf";
import "fonts/Rajdhani-SemiBold.ttf";
import "fonts/Rajdhani-Bold.ttf";
import "fonts/Orbitron.ttf";
import "fonts/JetBrainsMono-Regular.ttf";
import "fonts/JetBrainsMono-Bold.ttf";

export global C {
    out property <color> bg: #0A0B0D;
    out property <color> chrome: #0C0E10;
    out property <color> panel: #0F1114;
    out property <color> field: #111317;
    out property <color> sunk: #050607;
    out property <color> surface: #14171B;
    out property <color> raised: #1A1E23;
    out property <color> line: #1E2228;
    out property <color> line-soft: #191C21;
    out property <color> line2: #2E333A;
    out property <color> text: #ECEEF1;
    out property <color> sub: #B4BAC4;
    out property <color> muted: #9AA1AC;
    out property <color> dim: #6E7580;
    out property <color> ghost: #4A5059;
    out property <color> crimson: #DC2F45;
    out property <color> crimson-text: #FF6B7D;
    out property <color> err-text: #FF8A98;
    out property <color> ember: #FF7A3D;
    out property <color> green: #34D399;
    out property <color> amber: #F5B53D;
    out property <color> violet: #B79CFF;
    out property <color> term-text: #D5D9E0;

    out property <string> display: "Orbitron";
    out property <string> ui: "Rajdhani";
    out property <string> mono: "JetBrains Mono";

    public pure function state-color(kind: string) -> color {
        if kind == "Running" { return root.green; }
        if kind == "Suspended" { return root.amber; }
        if kind == "Locked" { return root.violet; }
        if kind == "Stopped" { return root.muted; }
        return root.dim;
    }
}

// Icon paths on a 24×24 viewbox (from the prototype's SVG set).
export global Icons {
    out property <string> play: "M6 4 L20 12 L6 20 Z";
    out property <string> stop: "M7 5 H17 A2 2 0 0 1 19 7 V17 A2 2 0 0 1 17 19 H7 A2 2 0 0 1 5 17 V7 A2 2 0 0 1 7 5 Z";
    out property <string> restart: "M3 12 A9 9 0 1 0 6 5.3 L3 8 M3 3 V8 H8";
    out property <string> pause: "M7 4 H9 A1 1 0 0 1 10 5 V19 A1 1 0 0 1 9 20 H7 A1 1 0 0 1 6 19 V5 A1 1 0 0 1 7 4 Z M15 4 H17 A1 1 0 0 1 18 5 V19 A1 1 0 0 1 17 20 H15 A1 1 0 0 1 14 19 V5 A1 1 0 0 1 15 4 Z";
    out property <string> term: "M4 17 L10 11 L4 5 M12 19 L20 19";
    out property <string> camera: "M14.5 4 H9.5 L7 7 H4 A2 2 0 0 0 2 9 V18 A2 2 0 0 0 4 20 H20 A2 2 0 0 0 22 18 V9 A2 2 0 0 0 20 7 H17 Z M15 13 A3 3 0 1 1 9 13 A3 3 0 1 1 15 13 Z";
